[Unit]
Description=Smart Thermostat Local Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
WorkingDirectory=@APP_DIR@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPYCACHEPREFIX=/run/smart-thermostat-backend/pycache
Environment=SMART_THERMOSTAT_RUNTIME_DIR=/run/smart-thermostat-backend
Environment=SMART_THERMOSTAT_UPDATE_RUNTIME_DIR=/dev/shm/smart-thermostat-self-update
Environment=SMART_THERMOSTAT_USB_RUNTIME_MOUNT_ROOT=/run/smart-thermostat-backend/usb-mounts
Environment=SMART_THERMOSTAT_ALARM_AUDIT_FILE=/run/smart-thermostat-backend/alarm-actions.log
Environment=XDG_CACHE_HOME=/run/smart-thermostat-backend/cache
Environment=PORT=8080
RuntimeDirectory=smart-thermostat-backend
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 @APP_DIR@/server.py --host 0.0.0.0 --port 8080
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
