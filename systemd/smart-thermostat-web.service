[Unit]
Description=IHA local web UI and Home Assistant discovery API
After=network-online.target avahi-daemon.service
Wants=network-online.target avahi-daemon.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__
Environment=SMART_THERMOSTAT_RESTART_SERVICES=smart-thermostat-web.service,smart-thermostat-native.service
ExecStart=/usr/bin/python3 __PROJECT_DIR__/server.py --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
