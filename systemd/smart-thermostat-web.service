[Unit]
Description=Smart Thermostat local web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__
ExecStart=/usr/bin/python3 -m http.server 8080 --directory public
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
