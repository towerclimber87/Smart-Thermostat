[Unit]
Description=IHA native thermostat appliance display
After=systemd-user-sessions.service smart-thermostat-web.service
Wants=smart-thermostat-web.service
Conflicts=getty@tty7.service smart-thermostat-kiosk.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PROJECT_DIR__
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/__USER__/.Xauthority
Environment=XDG_RUNTIME_DIR=/tmp/smart-thermostat-runtime-__UID__
EnvironmentFile=-/etc/smart-thermostat/native.env
ExecStart=__PROJECT_DIR__/scripts/native-xinit.sh
Restart=always
RestartSec=3
TTYPath=/dev/tty7
StandardInput=tty
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
