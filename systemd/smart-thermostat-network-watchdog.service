[Unit]
Description=IHA network watchdog for Ethernet priority and Wi-Fi reconnect
After=network-online.target NetworkManager.service wpa_supplicant.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-/etc/smart-thermostat/network-watchdog.env
ExecStart=/usr/bin/python3 __PROJECT_DIR__/scripts/network_watchdog.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
